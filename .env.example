# Sample settings, no secrets. Set real values as environment variables; never commit them.
# On Windows (once, in your own PowerShell):
#   [Environment]::SetEnvironmentVariable("GEMINI_API_KEY", "AIza...your key...", "User")
#   [Environment]::SetEnvironmentVariable("ADVISOR_REP_PASSWORD", "MyPassword123", "User")
# The value goes between the quotes as is (no < > around it). Open a new PowerShell window afterwards,
# and restart the server: a running server keeps the old value.

# Google AI Studio key. Optional: without it the chat is off and the form keeps working.
GEMINI_API_KEY=

# Password for the transport rep screen (user "rep"). Without it a random one is printed at startup.
ADVISOR_REP_PASSWORD=

# Permanent storage (optional). Without these, a local H2 file (wiped on every restart in the cloud).
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Optional overrides (defaults in src/main/resources/application.properties):
# ADVISOR_DATA_DIR=data                       -> folder with rules.json, catalog.csv, occupations.csv, use-value-2026.csv
# ADVISOR_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
